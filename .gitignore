# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Editors / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- Medical imaging: excluded by default ----
*.nii
*.nii.gz
*.nrrd
*.nrrd.gz
*.mha
*.mhd
*.dcm
*.dicom

# Exception: de-identified sample data ships with the repository
!examples/sample_data/
!examples/sample_data/*.nii.gz

# ---- Data directories never committed ----
data/
inputs/
outputs/
out/
results/

# ---- Tabular data: excluded by default ----
*.csv
*.tsv
*.xlsx
*.xls

# Exception: synthetic demo data (generated by examples/make_demo_clinic.py)
!examples/demo_data/
!examples/demo_data/demo_clinic.csv

# ---- Privacy: real-ID mapping and real-study baselines never committed ----
anonymization_map.*
*_mapping_real.*
expected_real_study.json

# ---- Misc ----
*.log
*.tmp
*.bak
